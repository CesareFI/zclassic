# rvuser fixtures: freestanding riscv64 FreeBSD-convention programs. Sources are ours (Apache-2.0), in src/.
# Convention verified against FreeBSD sys/riscv/riscv/trap.c (syscall number in t0, args a0..a5) and
# sys/riscv/riscv/vm_machdep.c (t0 = 0 ok / 1 error, a0 = value or errno); see rvuser README.
# Regenerate (authoring time only, no toolchain at test time; LLVM 20 at /usr/lib/llvm-20/bin, OBJ is any scratch dir):
#   F="--target=riscv64-unknown-freebsd -march=rv64imac -mabi=lp64 -ffreestanding -nostdlib -static -fno-pic -Os -fno-builtin -fno-stack-protector"
#   clang $F -c src/crt0.S -o $OBJ/crt0.o
#   for n in hello args mmap exit7 badsys cat fdhog badpath fileops; do clang $F -c src/$n.c -o $OBJ/$n.o && ld.lld -static -nostdlib -o $n.elf $OBJ/crt0.o $OBJ/$n.o; done
# lp64d fixture (fp), the same recipe with the hard-float ABI and no errno math:
#   D="--target=riscv64-unknown-freebsd -march=rv64imafdc -mabi=lp64d -ffreestanding -nostdlib -static -fno-pic -Os -fno-builtin -fno-math-errno -fno-stack-protector"
#   clang $D -c src/crt0.S -o $OBJ/crt0d.o; clang $D -c src/fp.c -o $OBJ/fp.o; ld.lld -static -nostdlib -o fp.elf $OBJ/crt0d.o $OBJ/fp.o
# spin: the ET_EXEC recipe on src/spin.c (host abort and budget tests).
# offguard: the ET_EXEC recipe on src/offguard.c (file offsets at INT64_MAX).
# static-PIE fixtures (pie_hello, pie_data): -fPIE, our crt0_pie.S relocates R_RISCV_RELATIVE itself:
#   P="--target=riscv64-unknown-freebsd -march=rv64imac -mabi=lp64 -ffreestanding -nostdlib -fPIE -Os -fno-builtin -fno-stack-protector"
#   clang $P -c src/crt0_pie.S -o $OBJ/crt0p.o
#   for n in pie_hello pie_data; do clang $P -c src/$n.c -o $OBJ/$n.o && ld.lld -pie --no-dynamic-linker -static -nostdlib -o $n.elf $OBJ/crt0p.o $OBJ/$n.o; done
