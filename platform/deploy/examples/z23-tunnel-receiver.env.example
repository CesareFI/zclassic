# Example environment file for
# platform/deploy/examples/z23-tunnel-receiver.service.
#
# Copy to:
#     ~/.config/z23/tunnel-receiver.env
#
# Z23_TUNNEL_RECEIVER_INPUT - absolute path of the receiver input JSON. The
#     file must be a regular file (not a symlink) owned by you and not
#     group/other writable, at most 4096 bytes. It is public route data, not
#     a secret. Example contents (one object, every field required):
#
#     {"directory":"/home/USER/.local/state/z23-tunnel/profile",
#      "peer_key":"<64 hex>","expected_root":"<64 hex>","target_port":22,
#      "route_id":"lan","listen_address":"0.0.0.0","listen_port":4022,
#      "allow_external":true,"lifetime_ms":600000,"handshake_ms":10000,
#      "session_ms":600000,"idle_ms":60000,"max_active":4,"max_sessions":64,
#      "confirm":true}
#
#     lifetime_ms <= 600000, max_sessions <= 64 and max_active <= 4 are the
#     leaf's own caps; larger values are refused (exit 2).
Z23_TUNNEL_RECEIVER_INPUT=/home/USER/.local/state/z23-tunnel/receiver.json
