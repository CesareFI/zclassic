z23verify.fixed_result.policy.v1
compiler_uid=60093
compiler_gid=60093
recorded_cwd=/zclassic23
source_image=/var/lib/z23verify/images/fixed_result/source
tool_image=/var/lib/z23verify/images/fixed_result/tool
check_image=/var/lib/z23verify/images/fixed_result/check
worker=/usr/local/libexec/z23-fixed-result-worker
bwrap=/usr/bin/bwrap
tree_closure=/usr/local/libexec/z23-tree-closure
seccomp_filter=/etc/z23verify/fixed_result.seccomp.bpf
launches=/var/lib/z23verify/launches
socket=/run/z23verify/fixed_result.launch.sock
request_timeout_ms=30000
worker_timeout_ms=30000
mounts=tool_ro,source_ro,work_private_tmpfs,tmp_private_tmpfs,dev_null
namespaces=user,mount,net,pid,ipc,uts,cgroup
network=none
fd_inheritance=stdio_only
