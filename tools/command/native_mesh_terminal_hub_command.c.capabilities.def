ZCL_MODULE_CAPABILITY("tools/command/native_mesh_terminal_hub_command.c", CAP_FS_READ|CAP_FS_WRITE|CAP_NET|CAP_PROCESS|CAP_CLOCK, "Reads the 0600 terminal key file, binds only 127.0.0.1, appends session audit lines to one named file or stderr, and forks one confined session child per accepted connection; no privilege is acquired")
